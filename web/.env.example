# Frontend env — set these in Vercel (Project → Settings → Environment Variables).
# Local dev: copy to .env.local and fill in. NEVER commit real values.

# Backend base URL (already set for S1/S2)
API_URL=https://lia-til.onrender.com

# --- S3 auth (GitHub OAuth + signed session) ---
# From the GitHub OAuth App you create (Settings → Developer settings → OAuth Apps):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random 32-byte secret that signs the session cookie. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=
# Your GitHub username — the ONLY account allowed into /private:
ALLOWED_GITHUB_LOGIN=patelinadev
# Shared secret for the backend's private endpoints — must EXACTLY match
# BACKEND_SECRET set on Render. Generate with: openssl rand -base64 32
BACKEND_SECRET=
