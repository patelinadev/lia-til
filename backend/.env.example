# Copy to .env for local runs (git-ignored). Never commit real secrets.
# Your Neon connection string (the pooled one, with -pooler, is fine for the app):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Shared secret gating the private read + write (CRUD) endpoints.
# Must be identical to BACKEND_SECRET on Render and on Vercel.
BACKEND_SECRET=your-shared-admin-secret
# Scoped write token — unlocks ONLY the daily-log + index routes (cloud/phone CRUD).
DAILYLOG_SECRET=your-scoped-daily-log-secret
# URL token that gates the MCP server for the phone/Cowork custom connector.
# The connector endpoint becomes https://<host>/mcp/<MCP_TOKEN>/ — knowing that URL
# is the credential. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Leave unset to disable the MCP server entirely.
MCP_TOKEN=your-long-random-url-token
